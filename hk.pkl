amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["cargo-fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["cargo-clippy"] {
    glob = List("**/*.rs", "**/Cargo.toml")
    check = "cargo clippy --workspace --all-targets -- -D warnings"
    fix = "cargo clippy --workspace --all-targets --fix --allow-staged --allow-dirty"
  }
  ["cargo-audit"] {
    glob = "Cargo.lock"
    check = "cargo audit"
  }
  ["okf-fmt"] {
    glob = List("docs/knowledgebase/**/*.md")
    check = "okf fmt --check docs/knowledgebase/"
    fix = "okf fmt --write docs/knowledgebase/"
  }
  ["okf-validate"] {
    glob = List("docs/knowledgebase/**/*.md")
    check = "okf validate docs/knowledgebase/"
  }
  ["biome"] {
    glob = List("crates/tower-web/**/*.css")
    check = "biome check crates/tower-web"
    fix = "biome check --write crates/tower-web"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
