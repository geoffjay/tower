{
	"id": "root",
	"type": "row",
	"titlebar": "none",
	"traffic_lights": [12, 16],
	"background": "canvas",
	"terminal_padding": [14, 12],
	"divider": { "width": 1, "color": "border" },
	"children": [
		{
			"id": "sidebar",
			"type": "column",
			"size": { "px": 300 },
			"min": 44,
			"max": 480,
			"background": "chrome",
			"resizable": false,
			"children": [
				{
					"id": "brand",
					"type": "block",
					"size": { "px": 46 },
					"window_drag": true,
					"content": { "mod": "workspace-chrome" }
				},
				{
					"id": "tower-agents",
					"type": "block",
					"size": { "weight": 3 },
					"min": 120,
					"content": { "mod": "tower-agents" }
				},
				{
					"id": "tower-inbox",
					"type": "block",
					"size": { "weight": 2 },
					"min": 90,
					"content": { "mod": "tower-inbox" }
				}
			]
		},
		{
			"id": "work",
			"type": "column",
			"resizable": false,
			"children": [
				{
					"id": "tabs",
					"type": "block",
					"size": { "px": 42 },
					"window_drag": true,
					"content": { "mod": "tower-tabs" }
				},
				{
					"id": "work-body",
					"type": "row",
					"padding": 8,
					"gap": 8,
					"children": [
						{
							"id": "main",
							"type": "block",
							"content": {
								"tab": "active",
								"pane": {
									"gap": 8,
									"radius": 10,
									"background": "background",
									"lone": true,
									"border": { "width": 1, "color": "border" },
									"focus": { "width": 1, "color": "accent" },
									"header": {
										"content": { "mod": "pane" },
										"height": 30,
										"position": "top",
										"reveal": "always"
									}
								}
							}
						},
						{
							"id": "panel",
							"type": "column",
							"size": { "px": 380 },
							"min": 280,
							"max": 900,
							"children": [
								{
									"id": "panel-body",
									"type": "stack",
									"active": "tower-jobs",
									"children": [
										{
											"id": "tower-jobs",
											"type": "block",
											"content": { "mod": "tower-jobs" }
										},
										{
											"id": "tower-events",
											"type": "block",
											"content": { "mod": "tower-events" }
										}
									]
								}
							]
						}
					]
				},
				{
					"id": "status",
					"type": "block",
					"size": { "px": 28 },
					"content": { "mod": "workspace-status" }
				}
			]
		}
	]
}
